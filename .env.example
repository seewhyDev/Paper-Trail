# Server-side only. Never paste your key into the UI or commit this file with values.
OPENAI_API_KEY=
# Any Responses API model that supports function calling; access depends on your account.
OPENAI_MODEL=gpt-5.4-mini
# Leave blank for models without reasoning effort support.
OPENAI_REASONING_EFFORT=low
PAPER_AGENT_DATA=data
# Optional: contact address used in academic API User-Agent / Crossref polite pool.
PAPER_AGENT_CONTACT=
# Optional font override. Bundled OFL NanumGothic is used by default on every OS.
PAPER_AGENT_FONT=
MAX_CANDIDATES=15
MAX_FULLTEXTS=5
# UI/live CLI always require exactly 3 papers; this setting is for evaluation.
TARGET_PAPERS=3
MAX_SEARCHES=6
MAX_MODEL_CALLS=auto
# auto: 검증된 브리핑 완성까지 호출. 숫자를 지정하면 해당 호출 상한 적용.
MAX_FINALIZATION_CALLS=auto
# 새 자료·근거·초안 없이 반복되는 연속 호출 상한 (3회째 복구 지시)
MAX_STALLED_TURNS=6
MAX_TOOL_CALLS=80
MAX_SECONDS=480
# auto: 완료까지 사용량에 맞춰 예약·계상. 숫자를 넣으면 고정 총량 상한 적용.
MAX_TOKENS=auto
MAX_OUTPUT_TOKENS=6500
NETWORK_TIMEOUT=20
NETWORK_RETRIES=1
